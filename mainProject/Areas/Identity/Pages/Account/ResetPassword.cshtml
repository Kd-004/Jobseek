@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-page">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>

    <div class="container position-relative py-5">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">

                <div class="text-center mb-4">
                    <span class="badge rounded-pill eyebrow-badge-accent px-3 py-2 mb-3">
                        <i class="bi bi-key-fill me-1"></i> Password Reset
                    </span>

                    <h1 class="fw-bold text-white display-6">
                        Reset Your Password
                    </h1>

                    <p class="text-light-50">
                        Enter your new password below to secure your account.
                    </p>
                </div>

                <div class="card auth-card">
                    <div class="card-body p-4 p-md-5">

                        <form method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert">
                            </div>

                            <input asp-for="Input.Code" type="hidden" />

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email"
                                       class="form-control dark-input"
                                       autocomplete="username"
                                       placeholder="name@example.com" />
                                <label asp-for="Input.Email"></label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password"
                                       class="form-control dark-input"
                                       autocomplete="new-password"
                                       placeholder="Password" />
                                <label asp-for="Input.Password"></label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control dark-input"
                                       autocomplete="new-password"
                                       placeholder="Confirm Password" />
                                <label asp-for="Input.ConfirmPassword"></label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit"
                                    class="btn btn-gradient-accent btn-lg w-100">
                                <i class="bi bi-check-circle me-2"></i>
                                Reset Password
                            </button>

                        </form>

                    </div>
                </div>

                <p class="text-center text-light-50 mt-4">
                    Remember your password?
                    <a asp-page="./Login" class="fw-semibold login-link">
                        Back to Login
                    </a>
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .auth-page {
        position: relative;
        min-height: 90vh;
        overflow: hidden;
        background: linear-gradient(160deg,#05070f 0%,#0b1330 45%,#101a3d 75%,#05070f 100%);
    }

    .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: .35;
        pointer-events: none;
    }

    .glow-1 {
        width: 500px;
        height: 500px;
        background: #2b5cff;
        top: -150px;
        left: -100px;
    }

    .glow-2 {
        width: 450px;
        height: 450px;
        background: #1e3a8a;
        bottom: -180px;
        right: -120px;
    }

    .eyebrow-badge-accent {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        color: #d1d5db;
        backdrop-filter: blur(6px);
    }

    .text-light-50 {
        color: rgba(255,255,255,.65) !important;
    }

    .auth-card {
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.04);
        backdrop-filter: blur(16px);
        box-shadow: 0 8px 30px rgba(0,0,0,.35);
    }

    .dark-input {
        background: rgba(255,255,255,.05) !important;
        border: 1px solid rgba(255,255,255,.12) !important;
        color: #fff !important;
    }

        .dark-input:focus {
            background: rgba(255,255,255,.08) !important;
            border-color: #6b7280 !important;
            box-shadow: 0 0 0 .2rem rgba(107,114,128,.25) !important;
        }

        .dark-input::placeholder {
            color: transparent;
        }

    .form-floating > label {
        color: rgba(255,255,255,.55);
    }

    .dark-input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px rgba(20,28,60,.9) inset !important;
        -webkit-text-fill-color: #fff !important;
    }

    .btn-gradient-accent {
        background: linear-gradient(135deg,#4b5563 0%,#111827 100%);
        color: #fff;
        border: 1px solid rgba(255,255,255,.1);
        font-weight: 600;
        transition: .25s;
    }

        .btn-gradient-accent:hover {
            color: #fff;
            filter: brightness(1.15);
            transform: translateY(-2px);
        }

    .login-link {
        color: #8ba4ff;
        text-decoration: none;
    }

        .login-link:hover {
            color: #b6c6ff;
        }
</style>