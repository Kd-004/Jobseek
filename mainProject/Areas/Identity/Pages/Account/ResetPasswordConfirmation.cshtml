@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="auth-page">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>

    <div class="container position-relative py-5">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">

                <div class="card auth-card text-center">
                    <div class="card-body p-5">

                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success display-1"></i>
                        </div>

                        <span class="badge rounded-pill eyebrow-badge-accent px-3 py-2 mb-3">
                            <i class="bi bi-shield-check me-1"></i>
                            Success
                        </span>

                        <h2 class="fw-bold text-white mb-3">
                            Password Reset Successfully
                        </h2>

                        <p class="text-light-50 mb-4">
                            Your password has been updated successfully.
                            You can now sign in using your new password.
                        </p>

                        <a asp-page="./Login"
                           class="btn btn-gradient-accent btn-lg w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Go to Login
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .auth-page {
        position: relative;
        min-height: 90vh;
        overflow: hidden;
        background: linear-gradient(160deg,#05070f 0%,#0b1330 45%,#101a3d 75%,#05070f 100%);
    }

    .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: .35;
        pointer-events: none;
    }

    .glow-1 {
        width: 500px;
        height: 500px;
        background: #2b5cff;
        top: -150px;
        left: -100px;
    }

    .glow-2 {
        width: 450px;
        height: 450px;
        background: #1e3a8a;
        bottom: -180px;
        right: -120px;
    }

    .eyebrow-badge-accent {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        color: #d1d5db;
        backdrop-filter: blur(6px);
    }

    .text-light-50 {
        color: rgba(255,255,255,.65) !important;
    }

    .auth-card {
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.04);
        backdrop-filter: blur(16px);
        box-shadow: 0 8px 30px rgba(0,0,0,.35);
    }

    .btn-gradient-accent {
        background: linear-gradient(135deg,#4b5563 0%,#111827 100%);
        color: #fff;
        border: 1px solid rgba(255,255,255,.1);
        font-weight: 600;
        transition: .25s;
    }

        .btn-gradient-accent:hover {
            color: #fff;
            filter: brightness(1.15);
            transform: translateY(-2px);
        }
</style>