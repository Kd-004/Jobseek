@model mainProject.ViewModels.UserDashboard

@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="theme-page h-100">

    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0 mt-2 fw-bold text-white mt-3">Welcome back, @(User.Identity?.Name ?? "User")</h3>
                    <p class="text-light-50 mb-0 small">Here's what's happening with your job search today.</p>
                    <br /><br />
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">

            <!--begin::Row - Stat Widgets-->
            <div class="row mb-4">
                <div class="col-lg-3 col-6">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <h3>@Model.AppliedJobs</h3>
                            <p>Applied Jobs</p>
                            <i class="bi bi-file-earmark-text-fill stat-card-icon"></i>
                        </div>
                        <a asp-controller="ApplyJob" asp-action="MyApplications" class="stat-card-footer">
                            View Applications <i class="bi bi-link-45deg"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <h3>@Model.AcceptedJobs</h3>
                            <p>Accepted Jobs</p>
                            <i class="bi bi-check-circle-fill stat-card-icon"></i>
                        </div>
                        <a asp-controller="ApplyJob" asp-action="MyApplications" class="stat-card-footer">
                            View Accepted <i class="bi bi-link-45deg"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <h3>@Model.RejectedJobs</h3>
                            <p>Rejected Jobs</p>
                            <i class="bi bi-x-circle-fill stat-card-icon"></i>
                        </div>
                        <a asp-controller="ApplyJob" asp-action="MyApplications" class="stat-card-footer">
                            View Rejected <i class="bi bi-link-45deg"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <h3>@Model.ProfileCompletion%</h3>
                            <p>Profile Completion</p>
                            <i class="bi bi-person-circle stat-card-icon"></i>
                        </div>
                        <a asp-controller="JobSeek" asp-action="Index" class="stat-card-footer">
                            Update Profile <i class="bi bi-link-45deg"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!--end::Row - Stat Widgets-->
            <!--begin::Quick Actions-->
            <div class="card glass-card mb-4 m-2">
                <div class="card-body py-3 px-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="text-light-50 small text-uppercase fw-semibold">Quick Actions</span>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="ApplyJob" asp-action="Index" class="btn btn-gradient-primary btn-sm">
                                <i class="bi bi-search me-1"></i> Find Jobs
                            </a>
                            <a asp-controller="ApplyJob" asp-action="MyApplications" class="btn btn-outline-glass btn-sm">
                                <i class="bi bi-file-earmark-text me-1"></i> My Applications
                            </a>
                            <a asp-controller="JobSeek" asp-action="Index" class="btn btn-outline-glass btn-sm">
                                <i class="bi bi-person me-1"></i> My Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Quick Actions-->
            <!--begin::Row - Recommended Jobs & Recent Applications-->
            <div class="row mb-5">
                <!-- Recommended Jobs -->
                <div class="col-lg-7">
                    <div class="card glass-card h-100 m-2">
                        <div class="card-header d-flex align-items-center">
                            <h3 class="card-title mb-0">
                                <i class="bi bi-briefcase me-2"></i>Recommended Jobs
                            </h3>
                            <a asp-controller="ApplyJob" asp-action="Index" class="btn btn-link btn-sm ms-auto text-decoration-none">
                                View All <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="card-body p-3">
                            @if (Model.RecommendedJobs.Any())
                            {
                                @foreach (var job in Model.RecommendedJobs)
                                {
                                    <div class="border border-secondary border-opacity-25 rounded-3 p-3 mb-3 bg-dark bg-opacity-10">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <h6 class="fw-bold text-white mb-1">
                                                    @job.JobTitle
                                                </h6>
                                                <small class="text-light-50 d-block mb-1">
                                                    <i class="bi bi-geo-alt me-1"></i>@job.Location
                                                    <span class="mx-2">•</span>
                                                    @job.EmploymentType
                                                </small>
                                                <div class="text-warning fw-semibold small">
                                                    ₹ @job.Salary
                                                </div>
                                            </div>
                                            <div>
                                                <a asp-controller="ApplyJob" asp-action="JobDetails" asp-route-id="@job.JobId" class="btn btn-sm btn-gradient-primary">
                                                    Apply Now
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 text-light">
                                    <i class="bi bi-search display-6 text-secondary d-block mb-2"></i>
                                    No Recommended Jobs
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Recent Applications -->
                <div class="col-lg-5">
                    <div class="card glass-card h-100 m-2">
                        <div class="card-header d-flex align-items-center">
                            <h3 class="card-title mb-0">
                                <i class="bi bi-clock-history me-2"></i>Recent Applications
                            </h3>
                            <span class="badge bg-primary ms-3">
                                @Model.RecentApplications.Count
                            </span>
                            <a asp-controller="ApplyJob" asp-action="MyApplications" class="btn btn-link btn-sm ms-auto text-decoration-none">
                                View All <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="card-body">
                            @if (Model.RecentApplications.Any())
                            {
                                @foreach (var application in Model.RecentApplications)
                                {
                                    <div class="d-flex align-items-center py-3 border-bottom border-secondary border-opacity-25">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1 text-white">
                                                @application.Job.JobTitle
                                            </h6>
                                            <small class="text-light-50">
                                                Applied: @application.AppliedDate.ToString("dd MMM yyyy")
                                            </small>
                                        </div>

                                        <div>
                                            @if (application.Status == "Accepted")
                                            {
                                                <span class="badge bg-success">Accepted</span>
                                            }
                                            else if (application.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 text-light">
                                    <i class="bi bi-person-x display-6 text-secondary d-block mb-2"></i>
                                    No Applications Yet
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Recent Notifications-->
           

        </div>
    </div>
    <!--end::App Content-->
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}