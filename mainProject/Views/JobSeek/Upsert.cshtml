@model JobPortal.Models.JobSeeker

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Job Seeker" : "Edit Job Seeker";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="theme-page py-5">
    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- Header -->
                <div class="text-center mb-4">
                    <span class="badge rounded-pill eyebrow-badge px-3 py-2 mb-3">
                        <i class="bi bi-person-plus me-1"></i> Job Seeker Profile
                    </span>
                    <h1 class="fw-bold text-white display-6">
                        @(Model.Id == 0 ? "Add Job Seeker" : "Update Job Seeker")
                    </h1>
                </div>

                <!-- Form Card -->
                <div class="card glass-card">
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Upsert" method="post" enctype="multipart/form-data" asp-controller="JobSeek">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="UserId" />
                            <input type="hidden" asp-for="Password" />
                            <div class="row">

                                <!-- Full Name -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label text-light-50"></label>
                                    <input asp-for="FullName" class="form-control dark-input" placeholder="Enter full name" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label text-light-50"></label>
                                    <input asp-for="Email" class="form-control dark-input" placeholder="Enter email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Phone -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label text-light-50"></label>
                                    <input asp-for="Phone" class="form-control dark-input" placeholder="Enter phone number" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <!-- Password -->
                           @*      <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label text-light-50"></label>
                                    <input asp-for="Password" type="password" class="form-control dark-input" placeholder="Enter password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div> *@

                                <!-- Date of Birth -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateOfBirth" class="form-label text-light-50"></label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control dark-input" min="1980-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>

                                <!-- Gender -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Gender" class="form-label text-light-50"></label>
                                    <select asp-for="Gender" class="form-select search-select">
                                        <option value="">-- Select Gender --</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                        <option>Other</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>

                                <!-- Address -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Address" class="form-label text-light-50"></label>
                                    <input asp-for="Address" class="form-control dark-input" placeholder="Enter address" />
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>

                                <!-- City -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="City" class="form-label text-light-50"></label>
                                    <input asp-for="City" class="form-control dark-input" placeholder="Enter city" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>

                                <!-- State -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="State" class="form-label text-light-50"></label>
                                    <input asp-for="State" class="form-control dark-input" placeholder="Enter state" />
                                    <span asp-validation-for="State" class="text-danger small"></span>
                                </div>

                                <!-- Country -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Country" class="form-label text-light-50"></label>
                                    <input asp-for="Country" class="form-control dark-input" placeholder="Enter country" />
                                    <span asp-validation-for="Country" class="text-danger small"></span>
                                </div>

                                <!-- Career Objective -->
                                <div class="col-12 mb-3">
                                    <label asp-for="CareerObjective" class="form-label text-light-50"></label>
                                    <textarea asp-for="CareerObjective" rows="4" class="form-control dark-input" placeholder="Write your career objective..."></textarea>
                                    <span asp-validation-for="CareerObjective" class="text-danger small"></span>
                                </div>

                                <!-- Highest Qualification -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HighestQualification" class="form-label text-light-50"></label>
                                    <input asp-for="HighestQualification" class="form-control dark-input" placeholder="Highest Qualification" />
                                    <span asp-validation-for="HighestQualification" class="text-danger small"></span>
                                </div>

                                <!-- Experience -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Experience" class="form-label text-light-50"></label>
                                    <input asp-for="Experience" class="form-control dark-input" placeholder="Years of Experience" />
                                    <span asp-validation-for="Experience" class="text-danger small"></span>
                                </div>

                                <!-- Current Salary -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CurrentSalary" class="form-label text-light-50"></label>
                                    <input asp-for="CurrentSalary" class="form-control dark-input" placeholder="Current Salary" />
                                    <span asp-validation-for="CurrentSalary" class="text-danger small"></span>
                                </div>

                                <!-- Expected Salary -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ExpectedSalary" class="form-label text-light-50"></label>
                                    <input asp-for="ExpectedSalary" class="form-control dark-input" placeholder="Expected Salary" />
                                    <span asp-validation-for="ExpectedSalary" class="text-danger small"></span>
                                </div>

                                <!-- Skills -->
                                <div class="col-12 mb-3">
                                    <label asp-for="Skills" class="form-label text-light-50"></label>
                                    <textarea asp-for="Skills" rows="3" class="form-control dark-input" placeholder="C#, ASP.NET Core, SQL, HTML, CSS..."></textarea>
                                    <span asp-validation-for="Skills" class="text-danger small"></span>
                                </div>

                                <!-- LinkedIn -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LinkedIn" class="form-label text-light-50"></label>
                                    <input asp-for="LinkedIn" class="form-control dark-input" placeholder="LinkedIn Profile URL" />
                                    <span asp-validation-for="LinkedIn" class="text-danger small"></span>
                                </div>

                                <!-- GitHub -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="GitHub" class="form-label text-light-50"></label>
                                    <input asp-for="GitHub" class="form-control dark-input" placeholder="GitHub Profile URL" />
                                    <span asp-validation-for="GitHub" class="text-danger small"></span>
                                </div>

                                <!-- Profile Image Upload -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-light-50">Profile Picture</label>
                                    <input type="file" name="ProfileImageFile" class="form-control dark-input dark-file-input" accept=".jpg,.jpeg,.png,.webp" />

                                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                    {
                                        <div class="mt-3">
                                            <img src="@Model.ProfileImage" alt="Profile Picture" class="img-thumbnail rounded-circle" style="width:100px; height:100px; object-fit:cover;" />
                                        </div>
                                    }
                                </div>

                                <!-- Resume Upload -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-light-50">Resume (PDF/DOCX)</label>
                                    <input type="file" name="ResumeUpload" class="form-control dark-input dark-file-input" accept=".pdf,.doc,.docx" />

                                    @if (!string.IsNullOrEmpty(Model.ResumeUrl))
                                    {
                                        <div class="mt-2">
                                            <a href="@Model.ResumeUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> View Current Resume
                                            </a>
                                        </div>
                                    }
                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-wrap gap-2 mt-4">
                                @if (Model.Id == 0)
                                {
                                    <button type="submit" class="btn btn-gradient-primary px-4">
                                        <i class="bi bi-check-circle me-1"></i> Save Job Seeker
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-gold px-4">
                                        <i class="bi bi-arrow-repeat me-1"></i> Update Job Seeker
                                    </button>
                                }

                                @if (Model.Id > 0)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-danger-glass px-4"
                                            formaction="@Url.Action("Delete", "JobSeeker")"
                                            formmethod="post"
                                            onclick="return confirm('Are you sure you want to delete this job seeker?');">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                }

                                <a asp-action="Index" class="btn btn-outline-glass px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Back
                                </a>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}