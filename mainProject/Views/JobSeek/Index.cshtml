@model JobPortal.Models.JobSeeker
@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
    ViewData["Title"] = "Job Seeker Profile";
}

<div class="theme-page py-5 h-100">
    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">

                @if (Model == null)
                {
                    <div class="card glass-card text-center">
                        <div class="card-body p-5">
                            <div class="icon-circle icon-circle-accent mb-4">
                                <i class="bi bi-person-plus"></i>
                            </div>
                            <h4 class="fw-bold text-white mb-2">No Profile Found</h4>
                            <p class="text-light-50 mb-4">
                                You haven't created your job seeker profile yet. Set it up to start applying for jobs and connecting with employers.
                            </p>
                            <a asp-action="Upsert" class="btn btn-gradient-primary btn-lg px-4">
                                <i class="bi bi-plus-circle me-1"></i> Create Profile
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center mb-4">
                        <span class="badge rounded-pill eyebrow-badge px-3 py-2 mb-3 test">
                            <i class="bi bi-person-badge me-1"></i> Job Seeker Profile
                        </span>
                    </div>

                    <div class="card glass-card">
                        <div class="card-header text-center">

                            @if (!string.IsNullOrEmpty(Model.ProfileImage))
                            {
                                <img src="~/@Model.ProfileImage"
                                     alt="@Model.FullName"
                                     class="rounded-circle border border-3 border-warning shadow mb-3"
                                     style="width:120px;height:120px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width:120px;height:120px;">
                                    <i class="bi bi-person text-white" style="font-size:48px;"></i>
                                </div>
                            }

                            <h3 class="fw-bold text-white mb-1">@Model.FullName</h3>
                            <span class="badge bg-warning text-dark px-3 py-1 fw-bold">@Model.HighestQualification</span>

                        </div>
                        <div class="card-body p-4">

                            <!-- Personal Details -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-envelope me-1"></i>Email</span>
                                <span class="text-white">@Model.Email</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-telephone me-1"></i>Phone</span>
                                <span class="text-white">@Model.Phone</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-calendar-event me-1"></i>Date of Birth</span>
                                <span class="text-white">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-gender-ambiguous me-1"></i>Gender</span>
                                <span class="text-white">@Model.Gender</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-geo-alt me-1"></i>Address</span>
                                <span class="text-white text-end">@Model.Address, @Model.City, @Model.State, @Model.Country</span>
                            </div>

                            <!-- Career Details -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-briefcase me-1"></i>Experience</span>
                                <span class="text-white">@Model.Experience yrs</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-cash-stack me-1"></i>Expected Salary</span>
                                <span class="text-white">@(Model.ExpectedSalary.HasValue? Model.ExpectedSalary.Value.ToString("C0") : "-")</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-tools me-1"></i>Skills</span>
                                <span class="text-white text-end">@Model.Skills</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.CareerObjective))
                            {
                                <div class="py-3 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                    <span class="text-light-50 small text-uppercase d-block mb-1">
                                        <i class="bi bi-journal-text me-1"></i>Career Objective
                                    </span>
                                    <p class="text-white small mb-0 fs-6">@Model.CareerObjective</p>
                                </div>
                            }

                            <!-- Social & Resume Links -->
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-file-earmark-pdf me-1"></i>Resume</span>
                                @if (!string.IsNullOrEmpty(Model.ResumeFile))
                                {
                                    <a href="~/@Model.ResumeFile" target="_blank" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-file-earmark-text me-1"></i> View Resume
                                    </a>
                                }
                                else
                                {
                                    <span class="text-light-50 small">-</span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: rgba(255,255,255,.08) !important;">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-linkedin me-1"></i>LinkedIn</span>
                                @if (!string.IsNullOrEmpty(Model.LinkedIn))
                                {
                                    <a href="@Model.LinkedIn" target="_blank" class="text-warning text-decoration-underline text-truncate" style="max-width: 200px;">
                                        @Model.LinkedIn
                                    </a>
                                }
                                else
                                {
                                    <span class="text-light-50 small">-</span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-2">
                                <span class="text-light-50 small text-uppercase"><i class="bi bi-github me-1"></i>GitHub</span>
                                @if (!string.IsNullOrEmpty(Model.GitHub))
                                {
                                    <a href="@Model.GitHub" target="_blank" class="text-warning text-decoration-underline text-truncate" style="max-width: 200px;">
                                        @Model.GitHub
                                    </a>
                                }
                                else
                                {
                                    <span class="text-light-50 small">-</span>
                                }
                            </div>

                            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-gold w-100 mt-4">
                                <i class="bi bi-pencil-square me-1"></i> Edit Profile
                            </a>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>